{
  "name": "sanad-action",
  "version": "0.3.5",
  "private": true,
  "description": "GitHub Action wrapper for Sanad",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --minify --license licenses.txt",
    "test": "node --test test/*.test.js",
    "test:integration": "npm run build && node test/run-local-integration.js",
    "test:local": "npm test && npm run test:integration && npm run check-dist",
    "check-dist": "npm run build && git diff --exit-code -- dist"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "1.11.1",
    "@actions/exec": "3.0.0",
    "@actions/tool-cache": "2.0.2"
  },
  "devDependencies": {
    "@vercel/ncc": "0.38.4"
  },
  "engines": {
    "node": ">=24"
  }
}
